{
  "name": "babeltron",
  "version": "1.1.10",
  "description": "Voice recorder with transcription and language detection",
  "main": "main/main.js",
  "scripts": {
    "build:renderer": "webpack --config webpack.config.js",
    "watch:renderer": "webpack --config webpack.config.js --watch",
    "start": "npm run build:renderer && electron .",
    "dev": "concurrently \"npm run watch:renderer\" \"electron .\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "webpack --mode production --config webpack.config.js && electron-builder --win --publish never",
    "release": "standard-version --releaseCommitMessageFormat 'chore(release): {{currentTag}} [skip ci]'",
    "build:prod-no-package": "webpack --mode production --config webpack.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.1",
    "html-webpack-plugin": "^5.6.3",
    "standard-version": "^9.5.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.1",
    "@mui/material": "^7.0.1",
    "electron-store": "^10.0.1",
    "openai": "^4.91.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wavesurfer.js": "^7.9.4"
  },
  "build": {
    "appId": "com.example.babeltron",
    "productName": "BabelTron",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/dist/**/*",
      "shared/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "extraMetadata": {
      "main": "main/main.js"
    }
  }
}
